# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Backend API
VITE_API_URL=http://localhost:3001

# --- Local development only: skip the Google login gate ---
# Set to true to auto sign-in with the email/password test account below.
# Ignored entirely in production builds (also gated on import.meta.env.DEV).
# Leave false / unset unless you are running `npm run dev`.
VITE_AUTH_BYPASS=false
# Credentials of a test user you created in your own Supabase project
# (Authentication > Users > Add user, with a password). Never commit real values:
# put them in frontend/.env.local, which is gitignored.
VITE_DEV_USER_EMAIL=dev@example.com
VITE_DEV_USER_PASSWORD=your-local-test-password
